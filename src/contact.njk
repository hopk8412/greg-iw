---
layout: layouts/base.njk
title: Contact
permalink: /contact/
---
<section class="panel h-card">
  <h1 class="panel__title">Contact</h1>

  <p>Reach <a class="p-name u-url" rel="me" href="{{ site.author.url }}">{{ site.author.name }}</a> at any of the following — these double as IndieAuth-verifying <code>rel="me"</code> links:</p>

  {% if site.author.email %}
    <p>
      Email: <a class="u-email" rel="me" href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>
    </p>
  {% endif %}

  {% if site.relMe.length %}
    <ul class="rel-me-list">
      {% for link in site.relMe %}
        <li><a rel="me" href="{{ link.href }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
